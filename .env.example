# Canonical site URL — used for metadata, Open Graph and JSON-LD.
# Set this to your real domain once Vercel assigns one.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# --- Contact form (optional) ---
# Without these the form still validates, but falls back to opening the
# visitor's mail client instead of sending directly.
# Get a key at https://resend.com (free tier is enough).
RESEND_API_KEY=
# Must be a domain you've verified with Resend, or onboarding@resend.dev for testing.
CONTACT_FROM="Portfolio <onboarding@resend.dev>"
# Where enquiries land. Defaults to the email in src/content/profile.ts.
CONTACT_TO=
